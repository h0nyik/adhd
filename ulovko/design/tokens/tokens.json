  "font": {
    "display": {
      "family": "Bricolage Grotesque",
      "use": "ceny a nadpisy; číslice vždy tabulkové"
    },
    "ui": {
      "family": "system",
      "use": "veškeré UI: SF Pro (Apple), Roboto Flex (Android), Segoe UI Variable (Windows)"
    }
  },
  "typeScale": {
    "caption": 12,
    "footnote": 13,
    "body": 15,
    "title": 20,
    "headline": 28,
    "price": 24,
    "priceHero": 40
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "s": 10,
    "m": 14,
    "l": 22,
    "sheet": 26
  },
  "motion": {
    "springResponseMs": 380,
    "springDampingPercent": 85,
    "fastMs": 180,
    "standardMs": 320
  },
  "haptic": {
    "vyber": {
      "kotlin": "SELECTION",
      "swift": "selection",
      "ios": ".selection",
      "swiftFeedback": ".selection",
      "android": "HapticFeedbackConstants.SEGMENT_TICK",
      "macos": ".alignment",
      "web": [
        8
      ],
      "use": "segment řazení, zarážka posuvníku, výběr varianty"
    },
    "prah": {
      "kotlin": "THRESHOLD",
      "swift": "threshold",
      "ios": ".impact(weight: .medium)",
      "swiftFeedback": ".impact(weight: .medium)",
      "android": "HapticFeedbackConstants.GESTURE_THRESHOLD_ACTIVATE",
      "macos": ".levelChange",
      "web": [
        15
      ],
      "use": "swipe akce zaklapne, tah k obnovení"
    },
    "uspech": {
      "kotlin": "SUCCESS",
      "swift": "success",
      "ios": ".success",
      "swiftFeedback": ".success",
      "android": "HapticFeedbackConstants.CONFIRM",
      "macos": ".generic",
      "web": [
        10,
        40,
        10
      ],
      "use": "přidáno do hlídání, recenze odeslána"
    },
    "chyba": {
      "kotlin": "ERROR",
      "swift": "error",
      "ios": ".error",
      "swiftFeedback": ".error",
      "android": "HapticFeedbackConstants.REJECT",
      "macos": ".generic",
      "web": [
        30,
        40,
        30
      ],
      "use": "akce se nepovedla"
    },
    "varovani": {
      "kotlin": "WARNING",
      "swift": "warning",
      "ios": ".warning",
      "swiftFeedback": ".warning",
      "android": "VibrationEffect.Composition (vlastní)",
      "macos": ".levelChange",
      "web": [
        20,
        60,
        20
      ],
      "use": "cena se před nákupem změnila"
    },
    "ulovek": {
      "kotlin": "CATCH",
      "swift": "catchMoment",
      "ios": ".success (+ vlastní Core Haptics vzor)",
      "swiftFeedback": ".success",
      "android": "VibrationEffect.Composition: PRIMITIVE_QUICK_RISE + PRIMITIVE_CLICK",
      "macos": ".generic",
      "web": [
        8,
        30,
        8,
        30,
        24
      ],
      "use": "cena klesla pod cíl, připsané úlovky"
    }
  }
}
