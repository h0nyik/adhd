  "contrast": [
    {
      "fg": "fg",
      "bg": "app",
      "min": 4.5
    },
    {
      "fg": "fg",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "muted",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "muted",
      "bg": "app",
      "min": 4.5
    },
    {
      "fg": "brandInk",
      "bg": "brand",
      "min": 4.5
    },
    {
      "fg": "brand",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "good",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "warn",
      "bg": "surface",
      "min": 4.5
