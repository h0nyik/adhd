    "bad": {
      "light": "#B42318",
      "dark": "#F2766D",
      "use": "chyba, minusy v recenzích"
    },
    "badSoft": {
      "light": "#FADFDB",
      "dark": "#3D1714",
      "use": "pozadí chyby"
    }
