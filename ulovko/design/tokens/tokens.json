{
  "meta": {
    "description": "Jediný zdroj pravdy pro barvy, typografii, rozestupy, pohyb a haptiku. Generuje Kotlin, Swift a CSS: node design/tokens/generate.mjs",
    "version": 1
  },
  "color": {
    "bg": {
      "light": "#E9EEEA",
      "dark": "#070B09",
      "use": "pozadí za oknem aplikace"
    },
    "app": {
      "light": "#F5F7F5",
      "dark": "#0D1311",
      "use": "pozadí obrazovky"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#151D1A",
      "use": "karty, řádky nabídek, listy"
    },
    "surface2": {
      "light": "#E8EEEA",
      "dark": "#1C2723",
      "use": "segmenty, miniatury, sekundární plochy"
    },
    "fg": {
      "light": "#0F1A15",
      "dark": "#E7EEEA",
      "use": "hlavní text, ceny"
    },
    "muted": {
      "light": "#55635C",
      "dark": "#97A59E",
      "use": "doplňkový text"
    },
    "line": {
      "light": "#D5DDD8",
      "dark": "#28342F",
      "use": "oddělovače, obrysy"
    },
    "brand": {
      "light": "#12614F",
      "dark": "#45C29B",
      "use": "hlavní akce, výběr"
    },
    "brandInk": {
      "light": "#FFFFFF",
      "dark": "#04241B",
      "use": "text na brand ploše"
    },
    "brandSoft": {
      "light": "#D7EBE3",
      "dark": "#16372D",
      "use": "zvýraznění výběru, upozornění"
    },
    "gold": {
      "light": "#8A5E0B",
      "dark": "#EBBB55",
      "use": "úlovky (text)"
